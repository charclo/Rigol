<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local Gitea package feed for NET_IPTE_SCPI. Fill in GITEA-HOST and
      GITEA-OWNER once the feed exists (see NET_IPTE_SCPI's README,
      "Publishing a new version"). Thanks to packageSourceMapping below,
      NuGet only contacts this source for the NET_IPTE_SCPI package - it
      has no effect on anything else, and no effect at all until
      Rigol.csproj switches from the submodule's ProjectReference to a
      PackageReference for NET_IPTE_SCPI. See README.md, "Switching to the
      NuGet package", for that cutover.
    -->
    <add key="gitea" value="http://GITEA-HOST/api/packages/GITEA-OWNER/nuget/index.json" />
  </packageSources>

  <!-- Only needed once the Gitea source above is actually reachable and in use.
       %GITEA_NUGET_USER% / %GITEA_NUGET_TOKEN% must be set as environment
       variables (locally, and as CI secrets once Rigol's own CI also
       restores from Gitea) - never hardcode credentials here. -->
  <packageSourceCredentials>
    <gitea>
      <add key="Username" value="%GITEA_NUGET_USER%" />
      <add key="ClearTextPassword" value="%GITEA_NUGET_TOKEN%" />
    </gitea>
  </packageSourceCredentials>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="gitea">
      <package pattern="NET_IPTE_SCPI*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
